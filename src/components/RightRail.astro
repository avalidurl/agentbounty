---
import { LEGAL_LINKS, TALLY, SITE } from "../data/links";
import type { TocItem } from "../layouts/DocsLayout.astro";

export interface Props {
  toc?: TocItem[];
  status?: "preview" | "alpha" | "live";
}

const { toc = [], status = "preview" } = Astro.props;
const statusLabel =
  status === "live"
    ? "Live"
    : status === "alpha"
      ? "Alpha"
      : "Preview";
---
<div class="rail-section rail-status">
  <h4>Status</h4>
  <span class="tag tag-status">{statusLabel}</span>
  <p style="margin: 8px 0 0; color: var(--muted); font-size: 12px;">
    {SITE.status}. Public examples may be preview data unless marked live.
  </p>
</div>

{toc.length > 0 ? (
  <div class="rail-section">
    <h4>On this page</h4>
    <ul>
      {toc.map((t) => (
        <li><a href={`#${t.anchor}`}>{t.label}</a></li>
      ))}
    </ul>
  </div>
) : null}

<div class="rail-cta">
  <h4>Early access</h4>
  <a
    class="button"
    href={TALLY.url}
    target="_blank"
    rel="noopener noreferrer"
  >
    {TALLY.buttonLabel}
  </a>
  <p>{TALLY.helperCopy}</p>
</div>

<div class="rail-section">
  <h4>Legal</h4>
  <ul>
    {LEGAL_LINKS.map((l) => (
      <li><a href={l.href}>{l.label}</a></li>
    ))}
  </ul>
</div>
