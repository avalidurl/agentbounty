---
import { SITE, TOP_NAV } from "../data/links";

const path = Astro.url.pathname;
const isActive = (href: string) => {
  if (href === "/") return path === "/" || path === "";
  return path === href || path.startsWith(href + "/");
};
---
<style>
  .site-header {
    border-bottom: 1px solid var(--line);
    background: var(--bg);
  }
  .site-header-inner {
    width: min(var(--max-content), calc(100vw - 32px));
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-4) 0;
  }
  .brand {
    text-decoration: none;
    color: var(--ink);
    font-weight: 700;
    letter-spacing: -0.02em;
    font-size: 18px;
  }
  .brand .brand-sub {
    color: var(--muted);
    font-weight: 500;
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    display: block;
    margin-top: 2px;
  }
  .nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    font-size: 13px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .nav a {
    text-decoration: none;
    color: var(--ink);
    padding: 4px 0;
    border-bottom: 1px solid transparent;
  }
  .nav a[aria-current="page"] {
    border-bottom-color: var(--ink);
  }
  .nav a:hover {
    border-bottom-color: var(--ink);
  }
</style>
<header class="site-header" aria-label="Site header">
  <div class="site-header-inner">
    <a class="brand" href="/" aria-label={`${SITE.name} home`}>
      {SITE.name}
      <span class="brand-sub">Bounty market for adjudicated work</span>
    </a>
    <nav aria-label="Primary navigation">
      <ul class="nav">
        {TOP_NAV.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isActive(item.href) ? "page" : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>
