---
import BaseLayout from "./BaseLayout.astro";
import RightRail from "../components/RightRail.astro";
import StatusBanner from "../components/StatusBanner.astro";
import "../styles/docs.css";
import "../styles/diagrams.css";

export interface TocItem {
  label: string;
  anchor: string;
}

export interface Props {
  title: string;
  description?: string;
  status?: "preview" | "alpha" | "live";
  toc?: TocItem[];
  eyebrow?: string;
  showStatusBanner?: boolean;
}

const {
  title,
  description,
  status = "preview",
  toc = [],
  eyebrow,
  showStatusBanner = true,
} = Astro.props;
---
<BaseLayout title={title} description={description}>
  {showStatusBanner ? <StatusBanner status={status} /> : null}
  <div class="docs-shell">
    <article class="docs-main">
      {eyebrow ? <p class="eyebrow">{eyebrow}</p> : null}
      <h1>{title}</h1>
      <slot />
    </article>
    <aside class="docs-rail" aria-label="Page table of contents and legal links">
      <RightRail toc={toc} status={status} />
    </aside>
  </div>
</BaseLayout>
