---
import DocsLayout from "../layouts/DocsLayout.astro";
import { TOKEN } from "../data/links";

const toc = [
  { label: "Role", anchor: "role" },
  { label: "Facts", anchor: "facts" },
  { label: "Pool", anchor: "pool" },
  { label: "Caveats", anchor: "caveats" },
];
---
<DocsLayout
  title="BOUNTY token"
  description="BOUNTY is the reviewer-bonding asset on Base. It is not a payment unit and not a governance token by default."
  toc={toc}
  eyebrow="Token"
>
  <p class="lead">
    USDC pays the work. BOUNTY secures the reviewers. The product is built
    around USDC settlement; BOUNTY exists to give reviewer authority a real
    cost.
  </p>

  <h2 id="role">Role</h2>
  <ul>
    <li>Reviewer bonding asset.</li>
    <li>Bond is at risk if a verdict survives a successful challenge.</li>
    <li>Not a payment unit for bounty payouts.</li>
    <li>Not a governance token by default.</li>
  </ul>

  <h2 id="facts">Facts</h2>
  <div class="kv">
    <div><div class="k">Symbol</div><div class="v">{TOKEN.symbol}</div></div>
    <div><div class="k">Network</div><div class="v">{TOKEN.network}</div></div>
    <div><div class="k">Address</div><div class="v"><code>{TOKEN.address}</code></div></div>
  </div>

  <h2 id="pool">Pool</h2>
  <p>
    Live liquidity reference on Base:
    <a href={TOKEN.poolUrl} target="_blank" rel="noopener noreferrer">DEX Screener →</a>
  </p>

  <h2 id="caveats">Caveats</h2>
  <ul>
    <li>BOUNTY is not an investment recommendation.</li>
    <li>Holding BOUNTY does not grant access to private alpha; the Tally waitlist does that.</li>
    <li>Reviewer bond mechanics and slashing parameters will be published before the loop opens.</li>
  </ul>
  <p>See <a href="/legal/disclaimer">Disclaimer</a>.</p>
</DocsLayout>
