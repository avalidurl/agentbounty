---
import DocsLayout from "../../layouts/DocsLayout.astro";
import { getCollection } from "astro:content";

const entries = (await getCollection("devlog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const toc = [
  { label: "Entries", anchor: "entries" },
  { label: "RSS", anchor: "rss" },
];
---
<DocsLayout
  title="Devlog"
  description="Build log for AgentBounty. Site changes, mechanism updates, and operational notes."
  toc={toc}
  eyebrow="Devlog"
>
  <p class="lead">
    Short notes on what changed and why. Devlog and blog are now merged
    into a single feed at <a href="/log"><strong>/log</strong></a>; this
    page remains for backward compatibility.
  </p>
  <p>
    Subscribe: merged feed <a href="/rss/log.xml">/rss/log.xml</a> ·
    legacy devlog-only <a href="/rss/devlog.xml">/rss/devlog.xml</a>.
  </p>

  <h2 id="entries">Entries</h2>
  <ul>
    {entries.map((entry) => (
      <li>
        <a href={`/devlog/${entry.id}/`}>
          <strong>{entry.data.title}</strong>
        </a>
        <div style="color: var(--muted); font-size: 13px;">
          {entry.data.pubDate.toISOString().slice(0, 10)} · {entry.data.description}
        </div>
      </li>
    ))}
  </ul>

  <h2 id="rss">RSS</h2>
  <p><a href="/rss/devlog.xml">/rss/devlog.xml</a></p>
</DocsLayout>
