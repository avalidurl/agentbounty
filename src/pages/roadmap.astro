---
import DocsLayout from "../layouts/DocsLayout.astro";
import RoadmapTimeline from "../components/diagrams/RoadmapTimeline.astro";

const toc = [
  { label: "Current status", anchor: "current" },
  { label: "Timeline", anchor: "timeline" },
  { label: "30-day plan", anchor: "30-day" },
  { label: "MVP scope", anchor: "mvp" },
  { label: "Deferred", anchor: "deferred" },
  { label: "Open decisions", anchor: "open" },
];
---
<DocsLayout
  title="Roadmap"
  description="Public maturity map. Each phase ships visible proof before the next opens."
  toc={toc}
  eyebrow="Roadmap"
>
  <p class="lead">
    The product is in <code>v0.0</code>: documentation and intake. The first
    private alpha loop is the next gate.
  </p>

  <h2 id="current">Current status</h2>
  <ul>
    <li>Network: Base.</li>
    <li>Token: BOUNTY (reviewer bonding only, not a payment unit).</li>
    <li>Public surface: roadmap, docs, beta waitlist.</li>
    <li>Bounty loop: not live yet. Curated sponsors and reviewers will run the first loop.</li>
  </ul>

  <h2 id="timeline">Timeline</h2>
  <RoadmapTimeline current="v0.0" />

  <h2 id="30-day">30-day plan</h2>
  <ol>
    <li>Ship public roadmap and docs site.</li>
    <li>Open beta waitlist via Tally.</li>
    <li>Stand up a private alpha loop with curated sponsors and reviewers.</li>
    <li>Run a small number of real bounties end to end on Base testnet first.</li>
    <li>Publish public proof of the first paid loops.</li>
  </ol>

  <h2 id="mvp">MVP scope</h2>
  <table>
    <thead><tr><th>Capability</th><th>State</th><th>Notes</th></tr></thead>
    <tbody>
      <tr><td>USDC bounty creation</td><td>Planned</td><td>Curated sponsors only.</td></tr>
      <tr><td>USDC escrow</td><td>Planned</td><td>Audited primitive on Base.</td></tr>
      <tr><td>Submission intake</td><td>Planned</td><td>Evidence-backed.</td></tr>
      <tr><td>Reviewer admission</td><td>Planned</td><td>Manual + checklist.</td></tr>
      <tr><td>BOUNTY bonding</td><td>Planned</td><td>Required for reviewers.</td></tr>
      <tr><td>Public proof pages</td><td>Planned</td><td>Verdict, reviewer, tx, hashes.</td></tr>
    </tbody>
  </table>

  <h2 id="deferred">Deferred</h2>
  <ul>
    <li>Permissionless reviewer admission.</li>
    <li>Automated reviewer admission policy.</li>
    <li>Broad bounty categories outside the narrow verification-friendly set.</li>
    <li>Cross-chain payouts.</li>
  </ul>

  <h2 id="open">Open decisions</h2>
  <ul>
    <li>Dispute escalation mechanics beyond v0.2.</li>
    <li>Category-specific policies and payout caps.</li>
    <li>Reviewer pseudonymity vs verified identity tradeoffs.</li>
    <li>Public bounty feed format and rate limits.</li>
  </ul>
</DocsLayout>
