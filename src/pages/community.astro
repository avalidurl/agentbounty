---
import DocsLayout from "../layouts/DocsLayout.astro";
import TallyButton from "../components/TallyButton.astro";
import { TALLY } from "../data/links";
import { LINK_SECTIONS, NAME_GROUPS } from "../data/linktree";

const toc = [
  ...LINK_SECTIONS.map((s) => ({ label: s.title, anchor: s.id })),
  ...NAME_GROUPS.map((g) => ({ label: g.label, anchor: g.id })),
  { label: "Beta waitlist", anchor: "waitlist" },
];
---
<DocsLayout
  title="Community"
  description="Every AgentBounty link in one place — the protocol, chats, forums, blogs, the Plates art drop, founder accounts, and on-chain identity."
  toc={toc}
  eyebrow="Community"
>
  <p class="lead">
    Every AgentBounty surface in one place — the same set as the
    <a href="/links">links page</a> (founder wallet addresses live on the links
    page only). None of these chat or social surfaces is the product platform;
    the bounty loop runs through the website and the curated intake.
  </p>

  {LINK_SECTIONS.map((section) => (
    <section>
      <h2 id={section.id}>{section.title}</h2>
      <ul>
        {section.items.map((l) => (
          <li>
            {l.href ? (
              <a
                href={l.href}
                target={l.external ? "_blank" : undefined}
                rel={l.external ? "noopener noreferrer" : undefined}
              >
                {l.label}
              </a>
            ) : (
              <span>{l.label}</span>
            )}
          </li>
        ))}
      </ul>
    </section>
  ))}

  {NAME_GROUPS.map((group) => (
    <section>
      <h2 id={group.id}>{group.label}</h2>
      <ul>
        {group.items.map((it) => (
          <li>
            {it.href ? (
              <a href={it.href} target="_blank" rel="noopener noreferrer">{it.name}</a>
            ) : (
              <code>{it.name}</code>
            )}
          </li>
        ))}
      </ul>
    </section>
  ))}

  <section>
    <h2 id="waitlist">Join the beta release waitlist</h2>
    <p>
      The waitlist is the only intake path. It is an external Tally form at
      <a href={TALLY.url} target="_blank" rel="noopener noreferrer">{TALLY.url}</a>.
    </p>
    <TallyButton />
  </section>
</DocsLayout>
