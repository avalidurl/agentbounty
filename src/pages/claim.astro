  <!-- Client logic: eligibility check, gallery, marketplace, remix. ------ -->
  <!-- No wallet APIs here; this script is plain and runs everywhere. ----- -->
  <script is:inline define:vars={{ ARWEAVE_TX, GATEWAY, BASESCAN, OPENSEA_COLLECTION, SAGA_TITLE, SAGA_SUBTITLE, VERSES }}>
    (function () {
      // ---- normalize an address for comparison (no checksum validation) --
      function normAddr(s) {
        return (s || "").trim().toLowerCase();
      }
      function isHexAddr(s) {
        return /^0x[0-9a-fA-F]{40}$/.test((s || "").trim());
      }

      // ---- shared eligible.json loader (cached promise) ------------------
      var eligiblePromise = null;
      function loadEligible() {
        if (!eligiblePromise) {
          eligiblePromise = fetch("/claim/eligible.json").then(function (r) {
            if (!r.ok) throw new Error("eligible.json " + r.status);
            return r.json();
          });
        }
        return eligiblePromise;
      }
      // expose to the module script (wallet/claim) so it shares one fetch
      window.__abpLoadEligible = loadEligible;
      window.__abpNormAddr = normAddr;
      window.__abpIsHexAddr = isHexAddr;

      // =================================================================
      // 2. ELIGIBILITY CHECK (no wallet)
      // =================================================================
      var eInput = document.getElementById("elig-input");
      var eBtn = document.getElementById("elig-check");
      var eResult = document.getElementById("elig-result");
      var eMeta = document.getElementById("elig-meta");

      function setLine(el, text, kind) {
        el.textContent = text;
        el.classList.remove("ok", "bad");
        if (kind) el.classList.add(kind);
      }

      function runEligibilityCheck() {
        var raw = eInput.value;
        if (!isHexAddr(raw)) {
          setLine(eResult, "Enter a valid 0x… address (40 hex characters).", "bad");
          return;
        }
        setLine(eResult, "Checking…", null);
        loadEligible()
          .then(function (data) {
            var target = normAddr(raw);
            var list = (data.addresses || []).map(normAddr);
            var idx = list.indexOf(target);
            // also confirm a proof exists for the checksummed key
            var proofKeys = Object.keys(data.proofs || {});
            var hasProof = proofKeys.some(function (k) {
              return normAddr(k) === target;
            });
            if (idx !== -1 && hasProof) {
              setLine(
                eResult,
                "Eligible. This address is in the published set and has a claim proof.",
                "ok"
              );
            } else if (idx !== -1) {
              setLine(
                eResult,
                "Listed as eligible, but no claim proof was found for it.",
                "bad"
              );
            } else {
              setLine(
                eResult,
                "Not eligible. This address is not in the published set.",
                "bad"
              );
            }
          })
          .catch(function () {
            setLine(eResult, "Could not load the eligible list. Try again.", "bad");
          });
      }

      eBtn.addEventListener("click", runEligibilityCheck);
      eInput.addEventListener("keydown", function (ev) {
        if (ev.key === "Enter") runEligibilityCheck();
      });
      // show how many addresses are published
      loadEligible()
        .then(function (data) {
          var n = (data.addresses || []).length;
          eMeta.textContent =
            n + " eligible addresses published · root " + (data.merkleRoot || "");
        })
        .catch(function () {});

      // =================================================================
      // 5. GALLERY
      // =================================================================
      var grid = document.getElementById("gallery-grid");
      var tierFilter = document.getElementById("tier-filter");
      var moreBtn = document.getElementById("gallery-more");
      var PLATES = [];
      var showAll = true;
      var INITIAL = 100;

      function plateImg(id) {
        return GATEWAY + "/" + id + ".png";
      }
      function arAddr(id) {
        return "ar://" + ARWEAVE_TX + "/" + id + ".png";
      }

      function renderGallery() {
        var tier = tierFilter.value;
        var rows = PLATES.filter(function (p) {
          return !tier || p.rarity === tier;
        });
        var limited = showAll ? rows : rows.slice(0, INITIAL);
        var html = limited
          .map(function (p) {
            var tip = "#" + p.id + " — " + p.title + " — " + p.rarity + " — " + arAddr(p.id);
            return (
              '<a class="plate-thumb" href="' + OPENSEA_COLLECTION + "/" + p.id + '" ' +
              'target="_blank" rel="noopener noreferrer" title="' + escapeHtml(tip) + '">' +
              '<img loading="lazy" width="300" height="300" ' +
              'src="' + plateImg(p.id) + '" alt="' + escapeHtml("Plate #" + p.id + " — " + p.title) + '" />' +
              "</a>"
            );
          })
          .join("");
        grid.innerHTML = html || '<p class="hint">No plates match this tier.</p>';
        var hiddenCount = rows.length - limited.length;
        if (showAll || hiddenCount <= 0) {
          moreBtn.hidden = rows.length <= INITIAL;
          moreBtn.textContent = "Show fewer";
          if (rows.length <= INITIAL) moreBtn.hidden = true;
        } else {
          moreBtn.hidden = false;
          moreBtn.textContent = "Show all (" + rows.length + ")";
        }
      }

      function escapeHtml(s) {
        return String(s)
          .replace(/&/g, "&amp;")
          .replace(/</g, "&lt;")
          .replace(/>/g, "&gt;")
          .replace(/"/g, "&quot;");
      }

      tierFilter.addEventListener("change", function () {
        showAll = false;
        renderGallery();
      });
      moreBtn.addEventListener("click", function () {
        showAll = !showAll;
        renderGallery();
      });

      fetch("/claim/plates.json")
        .then(function (r) { return r.json(); })
        .then(function (data) {
          PLATES = data.plates || [];
          window.__abpPlates = PLATES; // shared with the minted-plate display
          renderGallery();
        })
        .catch(function () {
          grid.innerHTML = '<p class="hint">Could not load the plate list.</p>';
        });

      // =================================================================
      // 6. MARKETPLACE (deep-link fallback; honest scope)
      // TODO: embed Reservoir / OpenSea Seaport when API key + indexing ready.
      // When that lands, replace the deep-links below with client-side
      // listing + bid calls (e.g. Reservoir SDK execute steps) so the user
      // can list/offer without leaving the page.
      // =================================================================
      var mToken = document.getElementById("market-token");
      var mList = document.getElementById("market-list");
      var mOffer = document.getElementById("market-offer");
      var mStatus = document.getElementById("market-status");

      function tokenIdOrNull() {
        var v = parseInt(mToken.value, 10);
        if (isNaN(v) || v < 0 || v > 99) return null;
        return v;
      }
      function openMarketplace(action) {
        var id = tokenIdOrNull();
        if (id === null) {
          setLine(mStatus, "Enter a token id from 0 to 99.", "bad");
          return;
        }
        // OpenSea token page; ?action hints intent where supported.
        var url = OPENSEA_COLLECTION + "/" + id;
        setLine(
          mStatus,
          (action === "list" ? "Opening listing page" : "Opening offer page") +
            " for plate #" + id + " in a new tab…",
          "ok"
        );
        window.open(url, "_blank", "noopener");
      }
      mList.addEventListener("click", function () { openMarketplace("list"); });
      mOffer.addEventListener("click", function () { openMarketplace("offer"); });

      // =================================================================
      // 9. REMIX — encode the skald instruction + full saga, build deep links
      // =================================================================
      function buildPrompt() {
        var lines = [];
        lines.push(
          "You are a skald — a saga-poet. Below is \"" +
            SAGA_TITLE +
            "\" (" +
            SAGA_SUBTITLE +
            "), a nine-verse saga from the Agent Bounty Plates collection by Gökhan Turhan. Its final verse asks every reader to tell the saga onward in their own cold tongue. Read it, then compose new verses (X, XI, XII …) that continue the ledger in the same plain, pitiless, northern register. Keep the imagery: the Verge, the Forge, ember, gates and shrines, watchers and verdicts, the Polestar, the Archive. Do not summarize — extend the saga."
        );
        lines.push("");
        lines.push("# " + SAGA_TITLE);
        lines.push("*" + SAGA_SUBTITLE + "*");
        lines.push("");
        VERSES.forEach(function (v) {
          lines.push("**" + v.numeral + "**");
          v.lines.forEach(function (l) { lines.push(l); });
          lines.push("");
        });
        lines.push("— Struck by Gökhan Turhan, at the Verge.");
        return lines.join("\n");
      }
      var prompt = buildPrompt();
      var encoded = encodeURIComponent(prompt);
      var claudeA = document.getElementById("remix-claude");
      var gptA = document.getElementById("remix-chatgpt");
      claudeA.href = "https://claude.ai/new?q=" + encoded;
      gptA.href = "https://chatgpt.com/?q=" + encoded;
    })();
  </script>

  <!-- Client logic: wallet connect + real on-chain claim via viem. ------- -->
  <!-- Plain <script> (no is:inline) so Astro processes it: viem is bundled -->
  <!-- from the local dependency and served, content-hashed, from this origin. -->
  <script>
    // @ts-nocheck — plain client JS (parity with its prior is:inline form, which was untyped)
    import {
      createPublicClient,
      createWalletClient,
      custom,
      http,
      decodeEventLog,
      isAddress,
      getAddress,
    } from "viem";
    import { base } from "viem/chains";

    const CONTRACT = "0x536fDf3027ae6F34499B4452aFbD9E1B872f6Bd2";
    const CHAIN_ID = 8453;
    const GATEWAY = "https://gateway.irys.xyz/52JESwVq4s3x94mc3Rb9EfNrLZMPwFiABkKiMJPAopDe";

    // Minimal ABI for the functions/events this page uses (matches the
    // deployed AgentBountyPlates contract).
    const ABI = [
      {
        type: "function",
        name: "claim",
        stateMutability: "nonpayable",
        inputs: [
          { name: "to", type: "address" },
          { name: "proof", type: "bytes32[]" },
        ],
        outputs: [{ name: "requestId", type: "uint256" }],
      },
      {
        type: "function",
        name: "claimDeadline",
        stateMutability: "view",
        inputs: [],
        outputs: [{ type: "uint256" }],
      },
      {
        type: "function",
        name: "hasClaimed",
        stateMutability: "view",
        inputs: [{ name: "", type: "address" }],
        outputs: [{ type: "bool" }],
      },
      {
        type: "function",
        name: "claimsOpen",
        stateMutability: "view",
        inputs: [],
        outputs: [{ type: "bool" }],
      },
      {
        type: "function",
        name: "remainingPlates",
        stateMutability: "view",
        inputs: [],
        outputs: [{ type: "uint256" }],
      },
      {
        type: "function",
        name: "MAX_SUPPLY",
        stateMutability: "view",
        inputs: [],
        outputs: [{ type: "uint256" }],
      },
      {
        type: "event",
        name: "ClaimRequested",
        inputs: [
          { name: "claimant", type: "address", indexed: true },
          { name: "recipient", type: "address", indexed: true },
          { name: "requestId", type: "uint256", indexed: true },
        ],
      },
      {
        type: "event",
        name: "PlateClaimed",
        inputs: [
          { name: "recipient", type: "address", indexed: true },
          { name: "tokenId", type: "uint256", indexed: true },
          { name: "requestId", type: "uint256", indexed: true },
        ],
      },
    ];

    // ---- DOM ----
    const $ = (id) => document.getElementById(id);
    const stateBox = $("claim-state");
    const connectBtn = $("connect-btn");
    const walletAddrEl = $("wallet-addr");
    const networkLine = $("network-line");
    const switchBtn = $("switch-btn");
    const destInput = $("dest-input");
    const destSelf = $("dest-self");
    const claimBtn = $("claim-btn");
    const claimStatus = $("claim-status");
    const yourPlateSection = $("your-plate");
    const yourPlateBody = $("your-plate-body");

    function setStatus(el, text, kind) {
      el.textContent = text;
      el.classList.remove("ok", "bad");
      if (kind) el.classList.add(kind);
    }

    // Public client (read-only) over Base via a public RPC. Used to read the
    // claim window even before any wallet is connected.
    const publicClient = createPublicClient({ chain: base, transport: http() });

    let walletClient = null;
    let account = null;
    let claimsOpen = false; // derived from claimDeadline()

    // ---- read claim window from chain ----
    async function refreshClaimWindow() {
      try {
        const [deadline, remaining] = await Promise.all([
          publicClient.readContract({ address: CONTRACT, abi: ABI, functionName: "claimDeadline" }),
          publicClient.readContract({ address: CONTRACT, abi: ABI, functionName: "remainingPlates" }),
        ]);
        const now = Math.floor(Date.now() / 1000);
        const dl = Number(deadline);
        if (dl === 0) {
          claimsOpen = false;
          stateBox.textContent =
            "Claim opens soon — the claim window has not been opened yet. " +
            remaining.toString() + " of 99 community plates remain.";
        } else if (now > dl) {
          claimsOpen = false;
          stateBox.textContent =
            "The claim window has closed. " + remaining.toString() +
            " plates went unclaimed. The gallery and marketplace below still work.";
        } else {
          claimsOpen = true;
          const left = dl - now;
          stateBox.textContent =
            "Claim is open. " + remaining.toString() +
            " of 99 plates remain. Window closes in " + fmtDuration(left) + ".";
          // live countdown
          scheduleCountdown(dl, remaining);
        }
      } catch (err) {
        stateBox.textContent =
          "Could not read the claim window from the contract (RPC error). You can still browse the gallery below.";
      }
      updateClaimButton();
    }

    let countdownTimer = null;
    function scheduleCountdown(dl, remaining) {
      if (countdownTimer) clearInterval(countdownTimer);
      countdownTimer = setInterval(function () {
        const now = Math.floor(Date.now() / 1000);
        const left = dl - now;
        if (left <= 0) {
          clearInterval(countdownTimer);
          claimsOpen = false;
          stateBox.textContent = "The claim window has just closed.";
          updateClaimButton();
          return;
        }
        stateBox.textContent =
          "Claim is open. " + remaining.toString() +
          " of 99 plates remain. Window closes in " + fmtDuration(left) + ".";
      }, 1000);
    }

    function fmtDuration(secs) {
      const d = Math.floor(secs / 86400);
      const h = Math.floor((secs % 86400) / 3600);
      const m = Math.floor((secs % 3600) / 60);
      const s = secs % 60;
      const parts = [];
      if (d) parts.push(d + "d");
      if (h || d) parts.push(h + "h");
      parts.push(m + "m");
      parts.push(s + "s");
      return parts.join(" ");
    }

    // ---- wallet connection ----
    function getEthereum() {
      return typeof window !== "undefined" ? window.ethereum : null;
    }

    async function connect() {
      const eth = getEthereum();
      if (!eth) {
        setStatus(
          claimStatus,
          "No browser wallet detected. Install a wallet (e.g. an injected EIP-1193 provider) to claim.",
          "bad"
        );
        networkLine.textContent = "No wallet found.";
        return;
      }
      try {
        walletClient = createWalletClient({ chain: base, transport: custom(eth) });
        const accounts = await walletClient.requestAddresses();
        account = accounts[0];
        walletAddrEl.hidden = false;
        walletAddrEl.textContent = account;
        connectBtn.textContent = "Wallet connected";
        await checkNetwork();
        await reflectEligibility();
      } catch (err) {
        setStatus(claimStatus, "Wallet connection was rejected or failed.", "bad");
      }
    }

    async function currentChainId() {
      const eth = getEthereum();
      try {
        const hex = await eth.request({ method: "eth_chainId" });
        return parseInt(hex, 16);
      } catch (e) {
        return null;
      }
    }

    async function checkNetwork() {
      const id = await currentChainId();
      if (id === CHAIN_ID) {
        networkLine.textContent = "Connected to Base (chain id 8453).";
        switchBtn.hidden = true;
      } else {
        networkLine.textContent =
          "Wrong network (chain id " + id + "). Switch to Base to claim.";
        switchBtn.hidden = false;
      }
      updateClaimButton();
      return id === CHAIN_ID;
    }

    async function switchToBase() {
      const eth = getEthereum();
      if (!eth) return;
      try {
        await eth.request({
          method: "wallet_switchEthereumChain",
          params: [{ chainId: "0x2105" }], // 8453
        });
      } catch (err) {
        // 4902 = chain not added
        if (err && (err.code === 4902 || (err.data && err.data.originalError && err.data.originalError.code === 4902))) {
          try {
            await eth.request({
              method: "wallet_addEthereumChain",
              params: [
                {
                  chainId: "0x2105",
                  chainName: "Base",
                  nativeCurrency: { name: "Ether", symbol: "ETH", decimals: 18 },
                  rpcUrls: ["https://mainnet.base.org"],
                  blockExplorerUrls: ["https://basescan.org"],
                },
              ],
            });
          } catch (e) {
            setStatus(claimStatus, "Could not add the Base network.", "bad");
          }
        } else {
          setStatus(claimStatus, "Network switch was rejected.", "bad");
        }
      }
      await checkNetwork();
    }

    // ---- find the connected address's proof from eligible.json ----
    async function proofFor(addr) {
      const loader = window.__abpLoadEligible;
      if (!loader) return null;
      const data = await loader();
      const proofs = data.proofs || {};
      // direct (checksum) hit first
      if (proofs[addr]) return proofs[addr];
      const target = (addr || "").toLowerCase();
      const key = Object.keys(proofs).find((k) => k.toLowerCase() === target);
      return key ? proofs[key] : null;
    }

    async function reflectEligibility() {
      if (!account) return;
      const proof = await proofFor(account);
      if (!proof) {
        setStatus(
          claimStatus,
          "The connected address is not in the eligible set — it cannot claim.",
          "bad"
        );
      } else {
        try {
          const claimed = await publicClient.readContract({
            address: CONTRACT, abi: ABI, functionName: "hasClaimed", args: [account],
          });
          if (claimed) {
            setStatus(claimStatus, "This address has already claimed its plate.", "ok");
            await showClaimedPlate(account);
          } else {
            setStatus(claimStatus, "Eligible and not yet claimed. You can claim.", "ok");
          }
        } catch (e) {
          setStatus(claimStatus, "Eligible. (Could not read claim status from chain.)", "ok");
        }
      }
      updateClaimButton();
    }

    async function updateClaimButton() {
      // Enable only when: claims open, wallet connected, on Base, eligible, not claimed.
      let enable = false;
      if (claimsOpen && account) {
        const onBase = (await currentChainId()) === CHAIN_ID;
        if (onBase) {
          const proof = await proofFor(account);
          if (proof) {
            try {
              const claimed = await publicClient.readContract({
                address: CONTRACT, abi: ABI, functionName: "hasClaimed", args: [account],
              });
              enable = !claimed;
            } catch (e) {
              enable = true; // allow attempt; contract will revert if already claimed
            }
          }
        }
      }
      claimBtn.disabled = !enable;
      claimBtn.textContent = claimsOpen ? "Claim (random plate)" : "Claim opens soon";
    }

    // ---- the claim transaction ----
    async function doClaim() {
      if (!account || !walletClient) {
        setStatus(claimStatus, "Connect a wallet first.", "bad");
        return;
      }
      if (!claimsOpen) {
        setStatus(claimStatus, "Claims are not open yet.", "bad");
        return;
      }
      if (!(await checkNetwork())) {
        setStatus(claimStatus, "Switch to Base before claiming.", "bad");
        return;
      }
      const proof = await proofFor(account);
      if (!proof) {
        setStatus(claimStatus, "No proof for this address — not eligible.", "bad");
        return;
      }
      // resolve destination
      let to = account;
      const destRaw = (destInput.value || "").trim();
      if (destRaw) {
        if (!isAddress(destRaw)) {
          setStatus(claimStatus, "Destination is not a valid address.", "bad");
          return;
        }
        to = getAddress(destRaw);
      }

      try {
        claimBtn.disabled = true;
        setStatus(claimStatus, "Confirm the transaction in your wallet…", null);
        const hash = await walletClient.writeContract({
          address: CONTRACT,
          abi: ABI,
          functionName: "claim",
          args: [to, proof],
          account,
        });
        setStatus(claimStatus, "Submitted. Waiting for confirmation… (" + hash + ")", null);
        const receipt = await publicClient.waitForTransactionReceipt({ hash });
        // claim() only REQUESTS randomness via Chainlink VRF. Parse ClaimRequested
        // to get our requestId; the plate is minted asynchronously (PlateClaimed),
        // typically ~30-60s later in the VRF fulfillment tx — NOT in this receipt.
        let requestId = null;
        for (const log of receipt.logs) {
          if (log.address.toLowerCase() !== CONTRACT.toLowerCase()) continue;
          try {
            const ev = decodeEventLog({ abi: ABI, data: log.data, topics: log.topics });
            if (ev.eventName === "ClaimRequested") { requestId = ev.args.requestId; break; }
          } catch (e) { /* not our event */ }
        }
        setStatus(claimStatus, "Claim confirmed ✓ — Chainlink VRF is assigning your random plate (usually ~30–60s). Watching for it…", "ok");
        // Watch for the plate being minted for this request.
        const unwatch = publicClient.watchContractEvent({
          address: CONTRACT,
          abi: ABI,
          eventName: "PlateClaimed",
          args: requestId != null ? { requestId: requestId } : { recipient: to },
          onLogs: function (logs) {
            const l = logs && logs[0];
            if (!l || !l.args) return;
            const tokenId = Number(l.args.tokenId);
            setStatus(claimStatus, "Your plate arrived — #" + tokenId + ".", "ok");
            renderMintedPlate(tokenId, to);
            try { unwatch(); } catch (e) {}
            refreshClaimWindow();
          },
        });
        // Safety: stop watching after 5 minutes.
        setTimeout(function () { try { unwatch(); } catch (e) {} }, 300000);
        await refreshClaimWindow();
        claimBtn.disabled = false;
      } catch (err) {
        const msg = (err && (err.shortMessage || err.message)) || "Transaction failed.";
        setStatus(claimStatus, "Claim failed: " + msg, "bad");
        claimBtn.disabled = false;
      }
    }

    // ---- after-mint display ----
    function plateData(id) {
      const list = window.__abpPlates || [];
      return list.find((p) => p.id === id) || { id: id, title: "Plate #" + id, rarity: "" };
    }

    function renderMintedPlate(tokenId, to) {
      const p = plateData(tokenId);
      const img = GATEWAY + "/" + tokenId + ".png";
      const ar = "ar://52JESwVq4s3x94mc3Rb9EfNrLZMPwFiABkKiMJPAopDe/" + tokenId + ".png";
      const opensea = "https://opensea.io/assets/base/" + CONTRACT + "/" + tokenId;
      yourPlateSection.hidden = false;
      yourPlateBody.innerHTML =
        '<img src="' + img + '" alt="Plate #' + tokenId + '" />' +
        "<div>" +
        "<h3 style=\"margin-top:0;\">" + escapeHtml(p.title) + "</h3>" +
        "<p>Token #" + tokenId + (p.rarity ? " · " + p.rarity : "") + "</p>" +
        '<p style="font-size:12px;color:var(--muted);word-break:break-all;"><code>' + ar + "</code></p>" +
        (to ? '<p style="font-size:12px;color:var(--muted);">Minted to ' + escapeHtml(to) + "</p>" : "") +
        '<p><a class="button" href="' + opensea + '" target="_blank" rel="noopener noreferrer">View on marketplace ↗</a></p>' +
        "</div>";
      yourPlateSection.scrollIntoView({ behavior: "smooth", block: "start" });
    }

    // If a connected wallet already claimed, we know hasClaimed=true but not
    // which tokenId (no on-chain reverse index). Show a gentle note + link.
    async function showClaimedPlate(addr) {
      yourPlateSection.hidden = false;
      const opensea = "https://opensea.io/" + encodeURIComponent(addr);
      yourPlateBody.innerHTML =
        "<div>" +
        "<h3 style=\"margin-top:0;\">Already claimed</h3>" +
        "<p>This address has already claimed its plate. Check the wallet, or view its collected items on the marketplace.</p>" +
        '<p><a class="button button-ghost" href="' + escapeHtml(opensea) + '" target="_blank" rel="noopener noreferrer">View wallet on OpenSea ↗</a></p>' +
        "</div>";
    }

    function escapeHtml(s) {
      return String(s)
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;");
    }

    // ---- wiring ----
    connectBtn.addEventListener("click", connect);
    switchBtn.addEventListener("click", switchToBase);
    claimBtn.addEventListener("click", doClaim);
    destSelf.addEventListener("click", function () {
      destInput.value = account || "";
    });

    // React to wallet account/chain changes if the provider supports events.
    const eth0 = getEthereum();
    if (eth0 && eth0.on) {
      eth0.on("accountsChanged", function (accs) {
        account = accs && accs[0] ? accs[0] : null;
        if (account) {
          walletAddrEl.hidden = false;
          walletAddrEl.textContent = account;
          reflectEligibility();
        } else {
          walletAddrEl.hidden = true;
          connectBtn.textContent = "Connect wallet";
        }
        updateClaimButton();
      });
      eth0.on("chainChanged", function () {
        checkNetwork();
      });
    }

    // initial read
    refreshClaimWindow();
  </script>
</BaseLayout>
