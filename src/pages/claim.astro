---
import BaseLayout from "../layouts/BaseLayout.astro";
import StatusBanner from "../components/StatusBanner.astro";
import "../styles/docs.css";

// ---------------------------------------------------------------------------
// Agent Bounty Plates — claim / gallery / marketplace page.
//
// The collection is LIVE on Base mainnet (chain id 8453).
//   Contract: 0x536fDf3027ae6F34499B4452aFbD9E1B872f6Bd2
//   ERC-721 "Agent Bounty Plates" / "PLATE", MAX_SUPPLY 100.
//   Token 0 = genesis "Archive" (founder, 1/1).
//
// Eligibility = the largest 99 traders, committed as a Merkle root.
//   Published list + per-address proofs live at /claim/eligible.json
//   (shape: { published, merkleRoot, addresses:[...], proofs:{checksumAddr:[bytes32,...]} }).
//
// Plate art resolves at the Irys gateway; the permanent reference is ar://<tx>/<id>.png.
// All title + rarity data is pre-baked into /claim/plates.json so the gallery
// does not need 100 on-chain reads.
//
// Contract surface actually deployed (verified on-chain against 0x536f…6Bd2):
//   claim(address to, bytes32[] proof) returns (uint256 requestId)
//     -> emits ClaimRequested(claimant, recipient, requestId); the plate is minted
//        ASYNCHRONOUSLY by Chainlink VRF, emitting PlateClaimed(recipient, tokenId, requestId).
//   claimsOpen() (bool)              // contract's open flag
//   claimDeadline() (uint256)        // 0 until opened; otherwise openTime + 5 days
//   hasClaimed(address) (bool)
//   remainingPlates() (uint256)      // community plates left
//   MAX_SUPPLY() (uint256)
//   tokenURI(uint256) (string), ownerOf(uint256) (address)
//
// NOTE: there is NO on-chain isEligible() — eligibility is checked client-side
// against eligible.json and proven by passing the Merkle proof to claim().
// ---------------------------------------------------------------------------

const CONTRACT = "0x536fDf3027ae6F34499B4452aFbD9E1B872f6Bd2";
const CHAIN_ID = 8453;
const ARWEAVE_TX = "52JESwVq4s3x94mc3Rb9EfNrLZMPwFiABkKiMJPAopDe";
const GATEWAY = `https://gateway.irys.xyz/${ARWEAVE_TX}`;
const BASESCAN = `https://basescan.org/address/${CONTRACT}`;
const OPENSEA_COLLECTION = `https://opensea.io/assets/base/${CONTRACT}`;
const LOGO = "https://gateway.irys.xyz/A7aFwNT7MuZiiLyugduxfZwCdASugBtNtpEgbAhGdVG";

// Rarity tiers (Founder / Polestar / Aurora / Forge / Ember / Cinder).
const TIERS = [
  { name: "Founder", meaning: "1/1 Archive · token 0", count: 1 },
  { name: "Polestar", meaning: "Legendary", count: 1 },
  { name: "Aurora", meaning: "Epic", count: 6 },
  { name: "Forge", meaning: "Rare", count: 14 },
  { name: "Ember", meaning: "Uncommon", count: 28 },
  { name: "Cinder", meaning: "Common", count: 50 },
];

// "The Ember Ledger" — the 9-verse saga. Embedded for rendering AND for the
// remix prompts (encoded client-side). Verbatim from the collection lore.
const SAGA_TITLE = "The Ember Ledger";
const SAGA_SUBTITLE = "A saga struck in a hundred plates.";
const VERSES: { numeral: string; lines: string[] }[] = [
  {
    numeral: "I.",
    lines: [
      "In the years before the thaw, when the Forge still slept beneath the ice,",
      "the first keepers came north to the Verge —",
      "where the sun is a low coal and the sky writes in green fire,",
      "and no word spoken is ever lost.",
    ],
  },
  {
    numeral: "II.",
    lines: [
      "They raised no throne and crowned no king.",
      "They raised a Ledger.",
      "And the Ledger took the shape of gates:",
      "torii of black iron, gantries of cold steel,",
      "each one a shrine to the work that was owed.",
    ],
  },
  {
    numeral: "III.",
    lines: [
      "The law of the Verge was plain and pitiless —",
      "the work is paid in ember, and the proof is bonded by watchers.",
      "No coin moved until a watcher had weighed it.",
      "No watcher weighed false twice.",
    ],
  },
  {
    numeral: "IV.",
    lines: [
      "To the Patron who fed the Forge, the Ember-Vault.",
      "To the Lantern-bearer, the long road between the pylons.",
      "To the Weigher of Verdicts, the Last Word.",
      "To the Keeper, the Ledger itself, that cannot lie and cannot thaw.",
    ],
  },
  {
    numeral: "V.",
    lines: [
      "They marked nothing in letters, for letters can be forged.",
      "They marked the work in light:",
      "a thin aurora for the small deeds,",
      "twin fires for the greater,",
      "and over the rarest, a single Polestar burning gold.",
    ],
  },
  {
    numeral: "VI.",
    lines: [
      "Once in the age there rose a plate so bright it inverted the night —",
      "the snow gone black, the heaven gone to gold.",
      "This they did not number among the hundred.",
      "This they called the Archive, and set it first, and spoke of it least.",
    ],
  },
  {
    numeral: "VII.",
    lines: [
      "The Black Stone of Witness stood unmarked on purpose,",
      "for a true thing needs no inscription.",
      "What was done at the Verge was done.",
      "What was bonded stayed bonded.",
    ],
  },
  {
    numeral: "VIII.",
    lines: [
      "They say the hundred keepers never died.",
      "They say each was struck into a plate and set into the ice,",
      "and that on the coldest night the gates still glow,",
      "waiting for the next who comes north owing work.",
    ],
  },
  {
    numeral: "IX.",
    lines: [
      "If you have come this far, you owe the Ledger nothing —",
      "only this: that you do not let the fire go out,",
      "and that you tell the saga onward, in your own cold tongue,",
      "and add to it what the keepers never wrote.",
    ],
  },
];

const toc = [
  { label: "Collection", anchor: "collection" },
  { label: "Check eligibility", anchor: "eligibility" },
  { label: "Claim", anchor: "claim" },
  { label: "Your plate", anchor: "your-plate" },
  { label: "Gallery", anchor: "gallery" },
  { label: "Offers & selling", anchor: "marketplace" },
  { label: "Reviewer benefit", anchor: "reviewer-benefit" },
  { label: "Lore", anchor: "lore" },
  { label: "Tell the saga onward", anchor: "remix" },
];
---

<BaseLayout
  title="Agent Bounty Plates"
  description="Agent Bounty Plates — a 100-piece ERC-721 collection on Base by Gökhan Turhan. A community airdrop to the largest 99 traders. Check eligibility, claim your plate, browse the gallery, and read The Ember Ledger."
>
  <StatusBanner status="live" />

  <!-- TOC -->
  <section class="shell" style="padding: var(--space-5) 0 0;">
    <nav class="page-toc" aria-label="On this page">
      <span class="page-toc-label">On this page</span>
      <ul>
        {toc.map((t) => (
          <li><a href={`#${t.anchor}`}>{t.label}</a></li>
        ))}
      </ul>
    </nav>
  </section>

  <!-- 1. HERO ------------------------------------------------------------ -->
  <section class="shell" style="padding: var(--space-5) 0 var(--space-6);" id="collection">
    <p class="eyebrow">NFT collection · Live on Base · ERC-721</p>
    <h1>Agent Bounty Plates</h1>
    <p class="lead">
      A hundred plates struck at the Verge — a community airdrop to the largest
      99 traders. Token 0 is the genesis Archive. Original works by Gökhan
      Turhan, live on Base.
    </p>
    <div class="hero-row">
      <img
        class="hero-logo"
        src={LOGO}
        alt="Agent Bounty Plates collection mark"
        width="120"
        height="120"
        loading="eager"
      />
      <div class="kv hero-kv">
        <div><div class="k">Name</div><div class="v">Agent Bounty Plates (PLATE)</div></div>
        <div><div class="k">Standard</div><div class="v">ERC-721 · 100 plates</div></div>
        <div><div class="k">Network</div><div class="v">Base · chain id {CHAIN_ID}</div></div>
        <div><div class="k">Artist</div><div class="v">Gökhan Turhan</div></div>
        <div>
          <div class="k">Contract</div>
          <div class="v">
            <a href={BASESCAN} target="_blank" rel="noopener noreferrer">
              <code>{CONTRACT}</code> ↗
            </a>
          </div>
        </div>
        <div>
          <div class="k">Distribution</div>
          <div class="v">Merkle airdrop to the largest 99 traders. Each claim assigns a random unminted plate.</div>
        </div>
      </div>
    </div>
    <p class="note">
      Each claim mints a <strong>random</strong> unminted plate — you do not
      choose the plate type or rarity tier.
    </p>
  </section>

  <!-- 2. ELIGIBILITY CHECK (no wallet) ----------------------------------- -->
  <section class="shell section" id="eligibility">
    <h2>Check eligibility</h2>
    <p>
      Paste any address to check it against the published eligible set. This is
      a pure read of the public list — <strong>no wallet connection, no
      signature</strong>.
    </p>
    <div class="panel-box">
      <label class="field-label" for="elig-input">Address to check</label>
      <div class="field-row">
        <input
          id="elig-input"
          class="text-input"
          type="text"
          inputmode="text"
          autocomplete="off"
          spellcheck="false"
          placeholder="0x…"
          aria-describedby="elig-result"
        />
        <button id="elig-check" class="button" type="button">Check</button>
      </div>
      <p id="elig-result" class="result-line" role="status" aria-live="polite"></p>
      <p class="hint" id="elig-meta"></p>
    </div>
  </section>

  <!-- 3. CLAIM / MINT ---------------------------------------------------- -->
  <section class="shell section" id="claim">
    <h2>Claim your plate</h2>
    <p>
      Claiming is on-chain and irreversible. The eligible address signs the
      transaction; the plate is minted to the destination wallet you choose
      (it can be a different wallet than the one that signs). One claim per
      eligible address.
    </p>

    <div id="claim-state" class="banner" role="status" aria-live="polite">
      Reading claim window from the contract…
    </div>

    <div class="panel-box" style="margin-top: var(--space-4);">
      <!-- Step: connect -->
      <div class="claim-step">
        <div class="field-row">
          <button id="connect-btn" class="button" type="button">Connect wallet</button>
          <span id="wallet-addr" class="mono-chip" hidden></span>
        </div>
        <p id="network-line" class="hint"></p>
        <button id="switch-btn" class="button button-ghost" type="button" hidden>
          Switch to Base
        </button>
      </div>

      <!-- Step: destination -->
      <div class="claim-step">
        <label class="field-label" for="dest-input">
          Destination wallet (where the plate is minted)
        </label>
        <div class="field-row">
          <input
            id="dest-input"
            class="text-input"
            type="text"
            autocomplete="off"
            spellcheck="false"
            placeholder="0x… (defaults to the connected wallet)"
          />
          <button id="dest-self" class="button button-ghost" type="button">Use connected</button>
        </div>
        <p class="hint">
          Leave blank to mint to the connected wallet, or paste a different
          address to redirect the plate.
        </p>
      </div>

      <!-- Step: claim -->
      <div class="claim-step">
        <button id="claim-btn" class="button" type="button" disabled>
          Claim (random plate)
        </button>
        <p id="claim-status" class="result-line" role="status" aria-live="polite"></p>
      </div>
    </div>
  </section>

  <!-- 4. AFTER MINT ------------------------------------------------------ -->
  <section class="shell section" id="your-plate">
    <h2>Your plate</h2>
    <div id="your-plate-body" class="minted-card">
      <p class="hint">After you connect an eligible wallet and claim, your randomly assigned plate appears here.</p>
    </div>
  </section>

  <!-- 5. GALLERY --------------------------------------------------------- -->
  <section class="shell section" id="gallery">
    <h2>Gallery</h2>
    <p>
      All 100 plates. Hover a thumbnail for its title, token id, rarity, and
      permanent <code>ar://</code> address on Arweave; click to open it on the
      marketplace.
    </p>
    <div class="gallery-controls">
      <label class="field-label" for="tier-filter">Filter by tier</label>
      <select id="tier-filter" class="select-input">
        <option value="">All tiers</option>
        {TIERS.map((t) => (
          <option value={t.name}>{t.name} ({t.count})</option>
        ))}
      </select>
      <button id="gallery-more" class="button button-ghost" type="button">Show all 100</button>
    </div>
    <div id="gallery-grid" class="gallery-grid" aria-live="polite"></div>
  </section>

  <!-- 6. MARKETPLACE (honest scope) -------------------------------------- -->
  <section class="shell section" id="marketplace">
    <h2>Offers &amp; selling</h2>
    <p>
      List a plate for sale or make an offer on one. Enter a token id to open
      the cleanest available trading path for that plate.
    </p>
    <div class="callout">
      <strong>On-site trading is scaffolded, not yet embedded.</strong> A fully
      embedded order book needs a marketplace API (Reservoir / OpenSea Seaport)
      plus the collection indexed by that marketplace. Until that is wired, the
      buttons below deep-link to the plate's marketplace page where listing and
      offers work today. No fake order book is shown.
    </div>
    <div class="panel-box">
      <label class="field-label" for="market-token">Token id (0–99)</label>
      <div class="field-row">
        <input
          id="market-token"
          class="text-input text-input-narrow"
          type="number"
          min="0"
          max="99"
          step="1"
          placeholder="e.g. 7"
        />
        <button id="market-list" class="button" type="button">List for sale ↗</button>
        <button id="market-offer" class="button button-ghost" type="button">Make offer ↗</button>
      </div>
      <p id="market-status" class="result-line" role="status" aria-live="polite"></p>
      <p class="hint">
        Opens the token's marketplace page in a new tab. The collection page is
        <a href={OPENSEA_COLLECTION} target="_blank" rel="noopener noreferrer">here ↗</a>.
      </p>
    </div>
  </section>

  <!-- 7. REVIEWER-BONDING BENEFIT ---------------------------------------- -->
  <section class="shell section" id="reviewer-benefit">
    <h2>A benefit for reviewers</h2>
    <div class="callout callout-strong">
      <strong>
        Plate holders who are human reviewers get 50% off reviewer bonding.
      </strong>
    </div>
    <p>
      Reviewers in the AgentBounty protocol post BOUNTY as a bond before they
      can sign verdicts. Holding an Agent Bounty Plate halves that bonding
      requirement for human reviewers. This is a protocol benefit — it is not
      configured or enforced on this page.
    </p>
    <p>
      <a href="/reviewers">Read how reviewers work →</a>
    </p>
  </section>

  <!-- 8. LORE ------------------------------------------------------------ -->
  <section class="shell section" id="lore">
    <h2>{SAGA_TITLE}</h2>
    <p class="lead" style="font-style: italic;">{SAGA_SUBTITLE}</p>
    <div class="saga">
      {VERSES.map((v) => (
        <div class="verse">
          <span class="verse-num">{v.numeral}</span>
          <p class="verse-lines">
            {v.lines.map((line, i) => (
              <>
                {line}
                {i < v.lines.length - 1 ? <br /> : null}
              </>
            ))}
          </p>
        </div>
      ))}
    </div>
    <p class="saga-colophon">Struck by Gökhan Turhan, at the Verge.</p>
  </section>

  <!-- 9. REMIX ----------------------------------------------------------- -->
  <section class="shell section" id="remix">
    <h2>Tell the saga onward</h2>
    <p>
      The last verse asks every reader to add to the saga in their own cold
      tongue. Open it in an assistant and continue the ledger.
    </p>
    <div class="field-row">
      <a id="remix-claude" class="button" href="#" target="_blank" rel="noopener noreferrer">
        Open in Claude ↗
      </a>
      <a id="remix-chatgpt" class="button button-ghost" href="#" target="_blank" rel="noopener noreferrer">
        Open in ChatGPT ↗
      </a>
    </div>
  </section>

  <!-- Page-scoped styles ------------------------------------------------- -->
  <style>
    .note {
      border-left: 3px solid var(--ink);
      padding: var(--space-2) var(--space-4);
      background: var(--panel);
      font-size: 14px;
      margin: var(--space-4) 0 0;
    }
    .hint {
      font-size: 12px;
      color: var(--muted);
      margin: var(--space-2) 0 0;
    }
    .hero-row {
      display: flex;
      gap: var(--space-5);
      align-items: flex-start;
      flex-wrap: wrap;
      margin: var(--space-4) 0 0;
    }
    .hero-logo {
      border: 1px solid var(--line);
      display: block;
      width: 120px;
      height: 120px;
      object-fit: cover;
      background: var(--panel);
      flex: 0 0 auto;
    }
    .hero-kv {
      flex: 1 1 360px;
      min-width: 280px;
    }
    .panel-box {
      border: 1px solid var(--line);
      background: var(--panel);
      padding: var(--space-4);
    }
    .field-label {
      display: block;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      font-size: 11px;
      color: var(--muted);
      margin: 0 0 var(--space-2);
      font-weight: 700;
    }
    .field-row {
      display: flex;
      gap: var(--space-3);
      flex-wrap: wrap;
      align-items: center;
    }
    .text-input,
    .select-input {
      flex: 1 1 320px;
      min-width: 0;
      font-family: var(--font-mono);
      font-size: 14px;
      padding: 0 12px;
      min-height: 44px;
      border: 1px solid var(--line);
      background: var(--panel-strong);
      color: var(--ink);
      border-radius: 0;
    }
    .text-input-narrow {
      flex: 0 0 160px;
    }
    .select-input {
      flex: 0 0 220px;
    }
    .text-input:focus,
    .select-input:focus {
      outline: 2px solid var(--ink);
      outline-offset: 2px;
    }
    .result-line {
      margin: var(--space-3) 0 0;
      font-size: 14px;
      min-height: 1.2em;
    }
    .result-line.ok {
      color: var(--ink);
      font-weight: 700;
    }
    .result-line.bad {
      color: var(--ink);
      font-weight: 700;
      text-decoration: underline;
      text-decoration-thickness: 2px;
    }
    .mono-chip {
      font-family: var(--font-mono);
      font-size: 12px;
      border: 1px solid var(--line);
      background: var(--panel-strong);
      padding: 6px 10px;
      word-break: break-all;
    }
    .claim-step {
      padding: var(--space-3) 0;
      border-top: 1px solid var(--line-soft);
    }
    .claim-step:first-child {
      border-top: 0;
      padding-top: 0;
    }
    .gallery-controls {
      display: flex;
      gap: var(--space-3);
      align-items: flex-end;
      flex-wrap: wrap;
      margin: 0 0 var(--space-5);
    }
    .gallery-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
      gap: var(--space-4);
    }
    .plate-card {
      border: 1px solid var(--line);
      background: var(--panel);
      display: flex;
      flex-direction: column;
      min-width: 0;
      overflow: hidden;
    }
    .plate-card .plate-img {
      display: block;
      width: 100%;
      aspect-ratio: 1 / 1;
      object-fit: cover;
      background: var(--panel-strong);
      border-bottom: 1px solid var(--line);
    }
    .plate-meta {
      padding: var(--space-3);
      display: flex;
      flex-direction: column;
      gap: 6px;
      min-width: 0;
    }
    .plate-title {
      font-size: 13px;
      font-weight: 700;
      line-height: 1.3;
    }
    .plate-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: var(--space-2);
      font-size: 12px;
      color: var(--muted);
      min-width: 0;
    }
    .plate-ar {
      font-size: 11px;
      color: var(--muted);
      border-top: 1px solid var(--line-soft);
      padding-top: 6px;
      min-width: 0;
    }
    .plate-ar code {
      display: block;
      font-size: 10.5px;
      background: transparent;
      border: 0;
      padding: 0;
      white-space: normal;
      word-break: break-all;
      overflow-wrap: anywhere;
      max-width: 100%;
    }
    .tier-badge {
      display: inline-block;
      border: 1px solid var(--line);
      background: var(--panel-strong);
      padding: 1px 6px;
      font-size: 10.5px;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      white-space: nowrap;
    }
    .tier-badge[data-tier="Founder"],
    .tier-badge[data-tier="Polestar"] {
      background: var(--ink);
      color: var(--panel);
      border-color: var(--ink);
    }
    .minted-card {
      border: 1px solid var(--line);
      background: var(--panel);
      padding: var(--space-5);
      display: flex;
      gap: var(--space-5);
      flex-wrap: wrap;
      align-items: center;
      justify-content: center;
      text-align: center;
      flex-direction: column;
    }
    .minted-card img {
      width: min(360px, 80vw);
      height: auto;
      border: 1px solid var(--line);
      display: block;
    }
    .saga {
      border: 1px solid var(--line);
      background: var(--panel);
      padding: var(--space-5);
    }
    .verse {
      display: grid;
      grid-template-columns: 48px minmax(0, 1fr);
      gap: var(--space-3);
      padding: var(--space-4) 0;
      border-top: 1px solid var(--line-soft);
    }
    .verse:first-child {
      border-top: 0;
      padding-top: 0;
    }
    .verse-num {
      font-weight: 700;
      color: var(--muted);
    }
    .verse-lines {
      margin: 0;
      line-height: 1.65;
    }
    .saga-colophon {
      font-style: italic;
      color: var(--muted);
      margin-top: var(--space-4);
      text-align: right;
    }
    @media (max-width: 560px) {
      .verse {
        grid-template-columns: 36px minmax(0, 1fr);
      }
      .gallery-grid {
        grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
      }
    }
  </style>

  <style is:global>
    /* Gallery + minted cards are injected by client-side JS, so Astro's scoped
       styles don't reach them — these MUST be global to actually apply. */
    .gallery-grid {
      display: grid !important;
      grid-template-columns: repeat(auto-fill, minmax(116px, 1fr)) !important;
      gap: 8px !important;
    }
    .plate-thumb {
      display: block;
      border: 1px solid var(--line);
      background: var(--panel-strong);
      aspect-ratio: 1 / 1;
      overflow: hidden;
    }
    .plate-thumb img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.15s ease;
    }
    .plate-thumb:hover { border-color: var(--ink); }
    .plate-thumb:hover img { transform: scale(1.04); }
    .plate-card {
      border: 1px solid var(--line);
      background: var(--panel);
      display: flex;
      flex-direction: column;
      min-width: 0;
      overflow: hidden;
    }
    .plate-card .plate-img {
      display: block;
      width: 100%;
      aspect-ratio: 1 / 1;
      object-fit: cover;
      background: var(--panel-strong);
      border-bottom: 1px solid var(--line);
    }
    .plate-meta { padding: 12px; display: flex; flex-direction: column; gap: 6px; min-width: 0; }
